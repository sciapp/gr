    <!-- definition of error_bar -->
    <xs:element name="error_bar">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="3">
                <xs:element ref="polyline" minOccurs="0" maxOccurs="3"/>
            </xs:choice>
            <xs:attributeGroup ref="move_xform_wc"/>
            <xs:attribute name="cap_x_max" type="xs:double"/>
            <xs:attribute name="cap_x_min" type="xs:double"/>
            <xs:attribute name="downwards_cap_color" type="xs:integer"/>
            <xs:attribute name="downwards_e" type="xs:double"/>
            <xs:attribute name="error_bar_color" type="xs:integer" use="required"/>
            <xs:attribute name="error_bar_x" type="xs:double" use="required"/>
            <xs:attribute name="error_bar_y_max" type="xs:double" use="required"/>
            <xs:attribute name="error_bar_y_min" type="xs:double" use="required"/>
