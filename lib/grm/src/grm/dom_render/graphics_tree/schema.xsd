    <xs:element name="cylinder">
        <xs:complexType>
            <xs:attribute name="color_rgb_values" type="xs:string" use="required"/>
            <xs:attribute name="length" type="xs:double" use="required"/>
            <xs:attribute name="radius" type="xs:double"/>
            <xs:attribute name="x" type="xs:double" use="required"/>
            <xs:attribute name="x_dir" type="xs:double" use="required"/>
            <xs:attribute name="y" type="xs:double" use="required"/>
            <xs:attribute name="y_dir" type="xs:double" use="required"/>
            <xs:attribute name="z" type="xs:double" use="required"/>
            <xs:attribute name="z_dir" type="xs:double" use="required"/>
            <xs:attribute name="z_index" type="xs:integer"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of sphere -->
    <xs:element name="sphere">
        <xs:complexType>
            <xs:attribute name="fill_color" type="xs:string" use="required"/>
            <xs:attribute name="radius" type="xs:double" use="required"/>
            <xs:attribute name="symbol" type="xs:string" use="required"/>
            <xs:attribute name="x" type="xs:double" use="required"/>
            <xs:attribute name="y" type="xs:double" use="required"/>
            <xs:attribute name="z" type="xs:double" use="required"/>
            <xs:attribute name="z_index" type="xs:integer"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of spin -->
    <xs:element name="spin">
        <xs:complexType>
            <xs:attribute name="fill_color" type="xs:string" use="required"/>
            <xs:attribute name="length" type="xs:double" use="required"/>
            <xs:attribute name="symbol" type="xs:string" use="required"/>
            <xs:attribute name="x" type="xs:double" use="required"/>
            <xs:attribute name="x_dir" type="xs:double" use="required"/>
            <xs:attribute name="y" type="xs:double" use="required"/>
            <xs:attribute name="y_dir" type="xs:double" use="required"/>
            <xs:attribute name="z" type="xs:double" use="required"/>
            <xs:attribute name="z_dir" type="xs:double" use="required"/>
            <xs:attribute name="z_index" type="xs:integer"/>
