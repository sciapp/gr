            <xs:attribute name="y" type="xs:string" use="required"/>
            <xs:attribute name="z" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of molecule -->
    <xs:element name="series_molecule">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element ref="cylinder" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="gr3_draw_image" minOccurs="0" maxOccurs="1"/> <!-- just for internal usage -->
                <xs:element ref="unit_cell" minOccurs="0" maxOccurs="1"/>
                <xs:element ref="sphere" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="spin" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="draw_image" minOccurs="0" maxOccurs="1"/> <!-- contourf -->
            </xs:choice>
            <xs:attributeGroup ref="move_xform_wc"/>
            <xs:attributeGroup ref="ranges"/>
            <xs:attribute name="ambient" type="xs:double"/>
            <xs:attribute name="cell" type="xs:string"/>
            <xs:attribute name="color_rgb_values" type="xs:string"/>
            <xs:attribute name="color_scheme" type="xs:integer"/>
            <xs:attribute name="connection_threshold" type="xs:double"/>
            <xs:attribute name="diffuse" type="xs:double"/>
            <xs:attribute name="kind" type="xs:string"/>
            <xs:attribute name="molecule_symbols" type="xs:string"/>
            <xs:attribute name="move_to_plot" type="xs:string"/>
            <xs:attribute name="radius_kind" type="xs:integer"/>
            <xs:attribute name="show_unit_cell" type="xs:integer"/>
            <xs:attribute name="specular" type="xs:double"/>
            <xs:attribute name="specular_power" type="xs:double"/>
            <xs:attribute name="spin_style" type="xs:integer"/>
            <xs:attribute name="spin_x" type="xs:string"/>
            <xs:attribute name="spin_y" type="xs:string"/>
            <xs:attribute name="spin_z" type="xs:string"/>
            <xs:attribute name="unified_connection_radius" type="xs:integer"/>
            <xs:attribute name="x" type="xs:string"/>
            <xs:attribute name="y" type="xs:string"/>
            <xs:attribute name="z" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of polar_heatmap -->
    <xs:element name="series_polar_heatmap">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element ref="nonuniform_polar_cell_array" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="polar_cell_array" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
            <xs:attributeGroup ref="move_xform_wc"/>
            <xs:attributeGroup ref="series"/>
            <xs:attribute name="kind" type="xs:string"/>
            <xs:attribute name="r" type="xs:string"/>
            <xs:attribute name="r_range_max" type="xs:double"/>
            <xs:attribute name="r_range_min" type="xs:double"/>
            <xs:attribute name="theta" type="xs:string"/>
            <xs:attribute name="theta_range_max" type="xs:double"/>
            <xs:attribute name="theta_range_min" type="xs:double"/>
            <xs:attribute name="z" type="xs:string" use="required"/>
            <xs:attribute name="z_dims" type="xs:string"/>
            <xs:attribute name="z_range_max" type="xs:double"/>
            <xs:attribute name="z_range_min" type="xs:double"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of polar_histogram -->
    <xs:element name="series_polar_histogram">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element ref="draw_arc" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="polar_bar" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="polyline" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
            <xs:attributeGroup ref="fill_modifications"/>
            <xs:attributeGroup ref="line_modifications"/>
            <xs:attributeGroup ref="move_xform_wc"/>
            <xs:attributeGroup ref="series"/>
            <xs:attribute name="bin_counts" type="xs:string"/>
            <xs:attribute name="bin_edges" type="xs:string"/>
            <xs:attribute name="bin_width" type="xs:double"/>
            <xs:attribute name="bin_widths" type="xs:string"/>
            <xs:attribute name="counts" type="xs:string"/>
            <xs:attribute name="draw_edges" type="xs:integer"/>
            <xs:attribute name="kind" type="xs:string"/>
            <xs:attribute name="norm" type="xs:string"/>
            <xs:attribute name="num_bins" type="xs:integer"/>
            <xs:attribute name="r_max" type="xs:double"/>
            <xs:attribute name="r_min" type="xs:double"/>
            <xs:attribute name="r_range_max" type="xs:double"/>
            <xs:attribute name="r_range_min" type="xs:double"/>
            <xs:attribute name="stairs" type="xs:integer"/>
            <xs:attribute name="tick" type="xs:double"/>
            <xs:attribute name="transparency" type="xs:double"/>
            <xs:attribute name="theta" type="xs:string"/>
            <xs:attribute name="theta_data_lim_max" type="xs:double"/>
            <xs:attribute name="theta_data_lim_min" type="xs:double"/>
            <xs:attribute name="theta_range_max" type="xs:double"/>
            <xs:attribute name="theta_range_min" type="xs:double"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of polar_line -->
    <xs:element name="series_polar_line">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element ref="polyline" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="polymarker" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
            <xs:attributeGroup ref="line_modifications"/>
            <xs:attributeGroup ref="marker_modifications"/>
            <xs:attributeGroup ref="move_xform_wc"/>
            <xs:attributeGroup ref="series"/>
            <xs:attribute name="clip_negative" type="xs:int"/>
            <xs:attribute name="kind" type="xs:string"/>
            <xs:attribute name="label" type="xs:string"/>
            <xs:attribute name="r" type="xs:string" use="required"/>
            <xs:attribute name="r_max" type="xs:double"/>
            <xs:attribute name="r_min" type="xs:double"/>
            <xs:attribute name="r_range_max" type="xs:double"/>
            <xs:attribute name="r_range_min" type="xs:double"/>
            <xs:attribute name="theta" type="xs:string" use="required"/>
            <xs:attribute name="theta_range_max" type="xs:double"/>
            <xs:attribute name="theta_range_min" type="xs:double"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of polar_scatter -->
    <xs:element name="series_polar_scatter">
        <xs:complexType>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element ref="polymarker" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
            <xs:attributeGroup ref="marker_modifications"/>
            <xs:attributeGroup ref="move_xform_wc"/>
            <xs:attributeGroup ref="series"/>
            <xs:attribute name="clip_negative" type="xs:int"/>
            <xs:attribute name="kind" type="xs:string"/>
            <xs:attribute name="label" type="xs:string"/>
            <xs:attribute name="r" type="xs:string" use="required"/>
            <xs:attribute name="r_max" type="xs:double"/>
            <xs:attribute name="r_min" type="xs:double"/>
            <xs:attribute name="r_range_max" type="xs:double"/>
            <xs:attribute name="r_range_min" type="xs:double"/>
            <xs:attribute name="theta" type="xs:string" use="required"/>
            <xs:attribute name="theta_range_max" type="xs:double"/>
            <xs:attribute name="theta_range_min" type="xs:double"/>
        </xs:complexType>
    </xs:element>

    <!-- definition of quiver -->
    <xs:element name="series_quiver">
        <xs:complexType>
